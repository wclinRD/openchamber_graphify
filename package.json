{
  "name": "openchamber-graphify",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "OpenChamber extension with a graphify-out interactive panel and status section",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "openchamber": {
    "apiVersion": 1,
    "contributes": {
      "panel": {
        "id": "openchamber-graphify",
        "name": "Graphify Graph",
        "icon": "graph.svg",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Graphify Graph",
        "height": 480,
        "defaultExpanded": false,
        "requiresProject": true
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  },

  "devDependencies": {
    "@openchamber/sdk": "^2.3.3",
    "@types/node": "^20"
  }
}
